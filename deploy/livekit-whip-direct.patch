+
+// trackPublishers resolves participants by identity (satisfied by *rtc.Room).
+type trackPublishers interface {
+	GetParticipant(identity livekit.ParticipantIdentity) types.LocalParticipant
+}
+
+// waitForPublishedTracks blocks until every requested publisher has published
+// every named track. It stops at once when the request is cancelled or the
+// waiting participant is closed, and gives up after timeout.
+func waitForPublishedTracks(
+	ctx context.Context,
+	room trackPublishers,
+	waiter types.LocalParticipant,
+	want map[string]*rpc.WHIPCreateRequest_TrackList,
+	timeout time.Duration,
+) error {
+	if len(want) == 0 {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	ticker := time.NewTicker(50 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if allTracksPublished(room, want) {
+			return nil
+		}
+		if waiter.IsClosed() || waiter.IsDisconnected() {
+			return psrpc.NewErrorf(psrpc.Canceled, "participant closed while waiting for tracks")
+		}
+		select {
+		case <-ctx.Done():
+			if errors.Is(ctx.Err(), context.DeadlineExceeded) {
+				return psrpc.NewErrorf(psrpc.DeadlineExceeded, "requested tracks were not published within %s", timeout)
+			}
+			return psrpc.NewErrorf(psrpc.Canceled, "request cancelled while waiting for tracks")
+		case <-ticker.C:
+		}
+	}
+}
+
+func allTracksPublished(room trackPublishers, want map[string]*rpc.WHIPCreateRequest_TrackList) bool {
+	for identity, list := range want {
+		publisher := room.GetParticipant(livekit.ParticipantIdentity(identity))
+		if publisher == nil {
+			return false
+		}
+		published := map[string]bool{}
+		for _, track := range publisher.GetPublishedTracks() {
+			published[track.Name()] = true
+		}
+		for _, name := range list.TrackNames {
+			if !published[name] {
+				return false
+			}
+		}
+	}
+	return true
+}
diff -ruN lk-direct.base/pkg/service/whip_wait_test.go lk-direct/pkg/service/whip_wait_test.go
--- lk-direct.base/pkg/service/whip_wait_test.go	1970-01-01 00:00:00.000000000 +0000
+++ lk-direct/pkg/service/whip_wait_test.go	2026-10-30 11:05:33.063736380 +0000
@@ -0,0 +1,135 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/livekit/livekit-server/pkg/rtc/types"
+	"github.com/livekit/livekit-server/pkg/rtc/types/typesfakes"
+	"github.com/livekit/protocol/livekit"
+	"github.com/livekit/protocol/rpc"
+	"github.com/livekit/psrpc"
+)
+
+type fakePublishers struct {
+	mu     sync.Mutex
+	tracks map[string][]string
+}
+
+func (f *fakePublishers) publish(identity string, names ...string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.tracks == nil {
+		f.tracks = map[string][]string{}
+	}
+	f.tracks[identity] = append(f.tracks[identity], names...)
+}
+
+func (f *fakePublishers) GetParticipant(identity livekit.ParticipantIdentity) types.LocalParticipant {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	names, ok := f.tracks[string(identity)]
+	if !ok {
+		return nil
+	}
+	p := &typesfakes.FakeLocalParticipant{}
+	var published []types.MediaTrack
+	for _, n := range names {
+		t := &typesfakes.FakeMediaTrack{}
+		t.NameReturns(n)
+		published = append(published, t)
+	}
+	p.GetPublishedTracksReturns(published)
+	return p
+}
+
+func wantAgentAudio() map[string]*rpc.WHIPCreateRequest_TrackList {
+	return map[string]*rpc.WHIPCreateRequest_TrackList{"agent-1": {TrackNames: []string{"roomio_audio"}}}
+}
+
+func rpcCode(t *testing.T, err error) psrpc.ErrorCode {
+	t.Helper()
+	var perr psrpc.Error
+	require.True(t, errors.As(err, &perr), "want a psrpc error, got %v", err)
+	return perr.Code()
+}
+
+func TestWaitForPublishedTracksReturnsAtOnceWhenTrackExists(t *testing.T) {
+	room := &fakePublishers{}
+	room.publish("agent-1", "roomio_audio")
+	start := time.Now()
+
+	err := waitForPublishedTracks(context.Background(), room, &typesfakes.FakeLocalParticipant{}, wantAgentAudio(), time.Second)
+
+	require.NoError(t, err)
+	require.Less(t, time.Since(start), 40*time.Millisecond)
+}
+
+func TestWaitForPublishedTracksWithNothingRequested(t *testing.T) {
+	err := waitForPublishedTracks(context.Background(), &fakePublishers{}, &typesfakes.FakeLocalParticipant{}, nil, time.Second)
+	require.NoError(t, err)
+}
+
+func TestWaitForPublishedTracksReturnsWhenTrackIsPublishedLater(t *testing.T) {
+	room := &fakePublishers{}
+	go func() {
+		time.Sleep(200 * time.Millisecond)
+		room.publish("agent-1", "roomio_audio")
+	}()
+
+	err := waitForPublishedTracks(context.Background(), room, &typesfakes.FakeLocalParticipant{}, wantAgentAudio(), 2*time.Second)
+
+	require.NoError(t, err)
+}
+
+func TestWaitForPublishedTracksIgnoresOtherTrackNames(t *testing.T) {
+	room := &fakePublishers{}
+	room.publish("agent-1", "some_other_track")
+
+	err := waitForPublishedTracks(context.Background(), room, &typesfakes.FakeLocalParticipant{}, wantAgentAudio(), 150*time.Millisecond)
+
+	require.Error(t, err)
+	require.Equal(t, psrpc.DeadlineExceeded, rpcCode(t, err))
+}
+
+func TestWaitForPublishedTracksTimesOut(t *testing.T) {
+	start := time.Now()
+
+	err := waitForPublishedTracks(context.Background(), &fakePublishers{}, &typesfakes.FakeLocalParticipant{}, wantAgentAudio(), 150*time.Millisecond)
+
+	require.Equal(t, psrpc.DeadlineExceeded, rpcCode(t, err))
+	require.Less(t, time.Since(start), time.Second)
+}
+
+func TestWaitForPublishedTracksStopsWhenRequestIsCancelled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	go func() {
+		time.Sleep(100 * time.Millisecond)
+		cancel()
+	}()
+	start := time.Now()
+
+	err := waitForPublishedTracks(ctx, &fakePublishers{}, &typesfakes.FakeLocalParticipant{}, wantAgentAudio(), 5*time.Second)
+
+	require.Equal(t, psrpc.Canceled, rpcCode(t, err))
+	require.Less(t, time.Since(start), time.Second)
+}
+
+func TestWaitForPublishedTracksStopsWhenParticipantCloses(t *testing.T) {
+	waiter := &typesfakes.FakeLocalParticipant{}
+	go func() {
+		time.Sleep(100 * time.Millisecond)
+		waiter.IsClosedReturns(true)
+	}()
+	start := time.Now()
+
+	err := waitForPublishedTracks(context.Background(), &fakePublishers{}, waiter, wantAgentAudio(), 5*time.Second)
+
+	require.Equal(t, psrpc.Canceled, rpcCode(t, err))
+	require.Less(t, time.Since(start), time.Second)
+}
